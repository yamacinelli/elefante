# Handle line endings automatically for text files
* text=auto

# Enforce LF (Linux/Mac) line endings for shell scripts and source code
/mvnw text eol=lf
*.sh text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf

# Enforce CRLF (Windows) line endings for batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified by Git
*.jar binary
*.war binary
*.zip binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
